# The Convex deployment the app signs in to. Leave empty to run on demo data only.
# Use a development deployment while building; never point a local build at production data.
EXPO_PUBLIC_CONVEX_URL=

# Web feedback button. Leave any of these empty and the button stays hidden.
# A picture is included only for paths the service lists. A prefix of every path covers every screen.
EXPO_PUBLIC_FEEDBACK_URL=
EXPO_PUBLIC_FEEDBACK_APP=
EXPO_PUBLIC_FEEDBACK_KEY=
