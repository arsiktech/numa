# Cloudflare Pages response headers for the web build.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Hashed bundles never change, so browsers can keep them.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images under /assets have the content hash in their file names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell can be reused for a moment, then rechecked. Hashed files keep the immutable rule.
/
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/index.html
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/pricing
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/pricing.html
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/privacy
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/privacy.html
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/terms
  Cache-Control: public, max-age=0, stale-while-revalidate=120
/terms.html
  Cache-Control: public, max-age=0, stale-while-revalidate=120

# Same address after every change, so these keep a short lifetime.
/legal.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
