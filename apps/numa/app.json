          "group.com.arsiktech.numa"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arsiktech.numa"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Numa Pro stores your sign-in session in the iPhone keychain and uses Face ID only if this iPhone asks you to unlock that session."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#000000"
        }
      ],
      "@bacons/apple-targets",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": "production"
        }
      },
      "eas": {
        "projectId": "37e9ec79-a5bc-4305-89cc-d9957e061cfb"
      }
    },
    "owner": "arsiktech",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/37e9ec79-a5bc-4305-89cc-d9957e061cfb",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
