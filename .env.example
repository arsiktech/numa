# Numa env vars — copy to `.env.local` and fill in what you need.
# See DEPLOYMENT.md for where each one actually has to live
# (Vercel project env vs Convex deployment env).

# ─── Convex connection (Vite frontend reads at build + runtime) ───────────────
# Generated by `npx convex dev` linking. CONVEX_DEPLOYMENT is the local CLI's
# target. VITE_CONVEX_URL is baked into the browser bundle.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Feature flag — when "1", auth flows hit Convex Auth instead of local email/password.
VITE_NUMA_CLOUD_AUTH=

# Feature flag — when "1", show the Numa AI surfaces (the "Ask Numa" assistant +
# the Numa AI page/tab). OFF by default. Also needs AI Gateway credits
# (AI_GATEWAY_API_KEY) or the surfaces will appear but fail.
VITE_NUMA_AI_ENABLED=

# ─── Market data (Vercel /api/market-quotes) ──────────────────────────────────
# Free Finnhub key for US-listed stock/ETF quotes (60 calls/min). Set it on
# Vercel and on the Convex deployment (iOS quote cron). Without it, equities
# are reported as unpriced. Crypto always uses CoinGecko's public endpoint.
FINNHUB_API_KEY=

# ─── Public crypto wallet tracking (Vercel /api/crypto-wallet-sync) ──────────
# Server-only Moralis Data API key. Reads public EVM/Solana/Bitcoin balances
# and supported EVM/Solana DeFi positions; never expose this as VITE_*.
MORALIS_API_KEY=
# Optional deployment-wide ceiling for token-balance wallet refreshes/day.
# Defaults to 60, leaving headroom beside the much more expensive DeFi calls.
NUMA_CRYPTO_DAILY_TOKEN_LIMIT=60
# Per-user share of the token budget, counted per wallet in a rolling 24h window.
NUMA_CRYPTO_DAILY_USER_TOKEN_LIMIT=12
# DeFi is a paid Moralis capability and is off unless explicitly enabled.
NUMA_CRYPTO_DEFI_ENABLED=0
# Optional deployment-wide ceiling for expensive DeFi wallet refreshes/day.
# Defaults to 12; tune this against the provider plan's 5,000-CU DeFi calls.
NUMA_CRYPTO_DAILY_WALLET_LIMIT=12
# Per-user share of the DeFi budget, counted per wallet in a rolling 24h window.
NUMA_CRYPTO_DAILY_USER_DEFI_LIMIT=4

# ─── AI chat (Vercel /api/chat) ───────────────────────────────────────────────
# Vercel AI Gateway API key — required for /api/chat (the "Ask Numa" feature).
AI_GATEWAY_API_KEY=

# ─── Web Push / VAPID (Vercel functions + browser) ────────────────────────────
# Generate a pair with: `npx web-push generate-vapid-keys --json`
# Public key ships to the browser. Private stays server-side.
VITE_NUMA_PUSH_VAPID_PUBLIC=
NUMA_PUSH_VAPID_PUBLIC=
NUMA_PUSH_VAPID_PRIVATE=
# Must be mailto: or https:// — used as the VAPID `sub` claim.
NUMA_PUSH_VAPID_SUBJECT=mailto:dev@example.com
# Shared bearer for internal /api/push-send callers (cron, server-side jobs).
NUMA_PUSH_INTERNAL_SECRET=

# ─── Convex deployment env vars (NOT in this file — set with `convex env set`) ─
# These DO NOT belong in .env.local. They go on the Convex deployment itself.
# Set DEV ones with:   npx convex env set NAME 'value'
# Set PROD ones with:  npx convex env --prod set NAME 'value'
#
#   SITE_URL                — where Convex Auth redirects after OAuth callback
#                             (dev: http://localhost:5173, prod: your prod URL)
#   AUTH_GOOGLE_ID          — Google OAuth client ID (Cloud Console)
#   AUTH_GOOGLE_SECRET      — Google OAuth client secret
#   AUTH_APPLE_ID           — (optional) Apple Sign-in Services ID
#   AUTH_APPLE_SECRET       — (optional) Apple client secret JWT
#   AUTH_APPLE_TEAM_ID      — (optional helper input for generating the JWT)
#   AUTH_APPLE_KEY_ID       — (optional helper input for generating the JWT)
#   JWKS / JWT_PRIVATE_KEY  — auto-generated by Convex Auth setup

# ─── Vercel env vars (NOT in this file — set with `vercel env add`) ───────────
# These also don't belong here. Vercel-only:
#
#   CONVEX_DEPLOY_KEY       — Convex Production Deploy Key. Triggers
#                             `convex deploy` during Vercel build and exposes
#                             prod VITE_CONVEX_URL to the Vite build.
