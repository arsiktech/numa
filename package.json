{
  "name": "numa",
  "version": "0.11.2",
  "private": true,
  "description": "Personal capital system — net worth, multi-currency cashflow, shared portfolios, market-linked holdings. Vite + React + Convex SPA.",
  "homepage": "https://numa-ecru.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/arsiktech/numa.git"
  },
  "keywords": [
    "personal-finance",
    "net-worth",
    "convex",
    "vite",
    "react",
    "tailwind",
    "pwa"
  ],
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node node_modules/typescript7/bin/tsc -b && vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --pool=vmThreads --no-isolate",
    "test:ui": "playwright test",
    "test:ui:production": "PLAYWRIGHT_BASE_URL=${NUMA_PRODUCTION_URL:-https://numa-ecru.vercel.app} playwright test tests/numa.spec.ts --grep \"Numa public smoke\"",
    "test:ui:auth": "playwright test tests/numa.spec.ts --grep \"Numa cloud-first smoke\"",
    "test:ui:production:auth": "PLAYWRIGHT_BASE_URL=${NUMA_PRODUCTION_URL:-https://numa-ecru.vercel.app} playwright test tests/numa.spec.ts --grep \"Numa cloud-first smoke\"",
    "test:ui:production:auth:required": "node scripts/require-e2e-env.mjs && npm run test:ui:production:auth",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:all": "npm audit --audit-level=moderate",
    "verify": "npm run lint && npm run build && npm run check:bundle && npm run test && npm run test:ui && npm run audit:release",
    "verify:live": "npm run verify:production && npm run test:ui:production",
    "verify:live:auth": "npm run verify:production:convex && npm run test:ui:production:auth:required",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production:convex": "node scripts/verify-production.mjs --require-convex",
    "handoff:bundle": "git bundle create artifacts/numa-mvp.bundle --all && git bundle verify artifacts/numa-mvp.bundle",
    "video:still": "remotion still remotion/index.ts NumaLaunch artifacts/screenshots/numa-video-still.png --frame=120 --image-format=png",
    "video:render": "remotion render remotion/index.ts NumaLaunch artifacts/numa-launch.mp4"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.14",
    "@anthropic-ai/sdk": "0.133.0",
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.94",
    "@types/web-push": "3.6.4",
    "ai": "7.0.18",
    "clsx": "2.1.1",
    "convex": "1.42.1",
    "date-fns": "4.4.0",
    "framer-motion": "12.42.2",
    "lucide-react": "1.23.0",
    "nanoid": "5.1.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/parser": "8.0.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@remotion/cli": "4.0.486",
    "@tailwindcss/vite": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "knip": "^5.88.1",
    "remotion": "4.0.486",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.63.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  },
  "overrides": {
    "ws": "8.21.0",
    "brace-expansion@^5.0.0": "5.0.12",
    "fast-uri": "3.1.8",
    "postcss": "8.5.23"
  }
}
